pipeline {
    agent any

    tools {
        maven 'Maven-3.9.6'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo '✅ Code récupéré'
            }
        }

        stage('Build (sans tests)') {
            steps {
                sh '''
                    mvn clean package -DskipTests
                '''
            }
        }

        stage('Analyse SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube-Ala') {
                    sh '''
                        mvn sonar:sonar \
                        -Dsonar.projectKey=test-devops \
                        -Dsonar.projectName=test-devops \
                        -Dsonar.projectVersion=1.0 \
                        -Dsonar.sources=src \
                        -Dsonar.java.binaries=target \
                        -DskipTests
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '🎉 Analyse SonarQube réussie'
        }
    }
}
